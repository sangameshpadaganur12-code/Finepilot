# Required for Supabase Auth and Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: Site URL for metadata (set to your Vercel production URL)
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Optional: For AI Copilot (Nemotron via NVIDIA API)
# Get from https://build.nvidia.com/nvidia/nemotron-3-ultra
NEMOTRON_API_KEY=your-nemotron-api-key
# or
NVIDIA_API_KEY=your-nvidia-api-key